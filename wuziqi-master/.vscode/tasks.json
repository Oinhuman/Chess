{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build wuziqi",
            "type": "shell",
            "command": "g++",
            "args": [
                "${workspaceFolder}/1.cpp",
                "-o",
                "${workspaceFolder}/1.exe",
                "-leasyx",
                "-lgdi32",
                "-limm32",
                "-lmsimg32",
                "-lole32",
                "-loleaut32",
                "-lwinhttp",
                "-lcrypt32",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "run wuziqi",
            "type": "shell",
            "command": "${workspaceFolder}/1.exe",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": "build wuziqi"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:\\GCC\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-leasyx",
                "-lgdi32",
                "-limm32",
                "-lmsimg32",
                "-lole32",
                "-loleaut32",
                "-lwinhttp",
                "-lcrypt32",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        },
        {
            "label": "C Build UTF-8 (gcc)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "通用 C 语言 UTF-8 编译"
        }
    ]
}
